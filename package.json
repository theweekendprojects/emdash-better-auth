{
  "name": "emdash-better-auth",
  "version": "0.1.0",
  "description": "Email/password + social (Google, GitHub) authentication for EmDash CMS, powered by Better Auth with prebuilt Better Auth UI sign-in/sign-up pages, mandatory email verification, and an admin settings page.",
  "type": "module",
  "license": "MIT",
  "author": "The Weekend Projects",
  "keywords": [
    "emdash",
    "emdash-plugin",
    "better-auth",
    "authentication",
    "auth",
    "oauth",
    "astro",
    "cloudflare"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theweekendprojects/emdash-better-auth.git"
  },
  "homepage": "https://github.com/theweekendprojects/emdash-better-auth#readme",
  "bugs": {
    "url": "https://github.com/theweekendprojects/emdash-better-auth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "plugin": {
    "id": "better-auth"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./admin": {
      "import": "./src/admin.tsx",
      "default": "./src/admin.tsx"
    },
    "./route": {
      "import": "./src/route.ts",
      "default": "./src/route.ts"
    },
    "./auth": {
      "import": "./src/auth.ts",
      "default": "./src/auth.ts"
    },
    "./adapter": {
      "import": "./src/emdash-adapter.ts",
      "default": "./src/emdash-adapter.ts"
    },
    "./settings-plugin": {
      "import": "./src/settings-plugin-entry.ts",
      "default": "./src/settings-plugin-entry.ts"
    },
    "./client": {
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./ui": {
      "import": "./src/ui/AuthView.tsx",
      "default": "./src/ui/AuthView.tsx"
    },
    "./pages/auth": {
      "import": "./src/pages/auth.astro",
      "default": "./src/pages/auth.astro"
    },
    "./pages/login": {
      "import": "./src/pages/login.astro",
      "default": "./src/pages/login.astro"
    },
    "./pages/signup": {
      "import": "./src/pages/signup.astro",
      "default": "./src/pages/signup.astro"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "emdash": ">=0.30.0",
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@better-auth-ui/core": "^1.7.19",
    "@better-auth-ui/heroui": "^1.7.19",
    "@better-auth-ui/react": "^1.7.19",
    "@better-auth/kysely-adapter": "^1.7.2",
    "@gravity-ui/icons": "^2.20.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@internationalized/date": "^3.12.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.2",
    "bowser": "^2.11.0",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "tailwind-merge": "^3.5.0",
    "ulidx": "^2.4.1",
    "zod": "^4.4.3"
  }
}
