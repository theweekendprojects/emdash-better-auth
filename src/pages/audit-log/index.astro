---
/**
 * Friendly `/audit-log` alias → the admin audit-log view served by the
 * `/audit-log/[...path]` catch-all (`/audit-log/log`). Mirrors how `/admin`
 * forwards into `/admin/users`. The catch-all does all the real work
 * (flag-gating, login-gating, rendering); this alias only forwards.
 *
 * We deliberately do NOT gate/render here: `Astro.locals.user` is reliably
 * populated on the catch-all route, not on this bare alias.
 */
const qs = Astro.url.search;
return Astro.redirect(`/audit-log/log${qs}`);
---
