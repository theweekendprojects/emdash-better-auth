---
/**
 * Plugin-shipped Better Auth UI admin page (user management) at /admin.
 * Rendered by the same island as /account/* so the sidebar and plugins are identical on every page.
 */
import { accountProps, ROLE_ADMIN } from "../../account-props.ts";
import { adminEnabled, auditLogEnabled, orgEnabled, teamsEnabled } from "../../providers.ts";
import { requireUser } from "../../route.ts";
import AccountView from "../../ui/AccountView.tsx";
const { path } = Astro.params;
const view = path && path !== "" ? path : "users";
if (!(await adminEnabled())) {
	return new Response("Not found", { status: 404 });
}
if (view !== "users") {
	return new Response("Not found", { status: 404 });
}
const gate = await requireUser(Astro);
if (gate) return gate;
const user = Astro.locals.user!;
if ((user.role ?? 0) < ROLE_ADMIN) {
	return new Response("Forbidden", { status: 403 });
}
const { accent, props } = await accountProps(user.role);
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
---
<!doctype html>
<html lang="en" class="antialiased" style={`--emdash-accent: ${accent}`}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preload" as="font" type="font/woff2" href={interFont} crossorigin />
		<title>Users admin</title>
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem("theme") || "system";
					const dark =
						stored === "dark" ||
						(stored === "system" &&
							window.matchMedia("(prefers-color-scheme: dark)").matches);
					document.documentElement.classList.toggle("dark", dark);
				} catch {}
			})();
		</script>
	</head>
	<body class="min-h-svh flex flex-col">
		<AccountView {...props} section="admin" path={view} client:load />
	</body>
</html>
