---
/**
 * Plugin-shipped Better Auth UI (HeroUI) account settings catch-all page.
 *
 * Injected at `/account/[...path]` via the plugin's AuthProviderDescriptor.routes.
 * Serves Better Auth UI's account settings views: `/account` (root redirect to
 * Settings), `/account/settings` (the main settings page), and sub-routes like
 * `/account/security` for password/linked-accounts management.
 *
 * The header, layout, and theme switcher all live inside the AccountView island
 * (they need Better Auth UI's provider context); this page is just the document
 * shell. Self-styled: HeroUI's stylesheet loads only with this island, so the
 * site's themed content pages are untouched.
 */
import { viewPaths } from "@better-auth-ui/core";
import { accountProps } from "../account-props.ts";
import { requireUser } from "../route.ts";
import { extraViews } from "../ui-plugin-views.ts";
import AccountView from "../ui/AccountView.tsx";

const { path } = Astro.params;
const view = path && path !== "" ? path : "home";
const gate = await requireUser(Astro);
if (gate) return gate;
const flags = await accountProps(Astro.locals.user.role);
const accent = flags.accent;
const knownViews = Object.values(viewPaths.settings) as string[];
const allowedViews = [
	...knownViews,
	"home",
	"users",
	"activity",
	...(flags.props.orgEnabled ? ["organizations"] : []),
	...(flags.props.billingEnabled ? ["billing"] : []),
	...(flags.props.oidcProviderEnabled ? ["oauth-clients"] : []),
	...extraViews("settings"),
];
if (!allowedViews.includes(view)) {
	return new Response("Not found", { status: 404 });
}
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
---
<!doctype html>
<html lang="en" class="antialiased" style={`--emdash-accent: ${accent}`}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preload" as="font" type="font/woff2" href={interFont} crossorigin />
		<title>Account</title>
		<!-- Apply the saved theme before paint to avoid a light/dark flash.
		     Mirrors next-themes' storage key/behavior so the island hydrates
		     into the same state. -->
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem("theme") || "system";
					const dark =
						stored === "dark" ||
						(stored === "system" &&
							window.matchMedia("(prefers-color-scheme: dark)").matches);
					document.documentElement.classList.toggle("dark", dark);
				} catch {}
			})();
		</script>
	</head>
	<body class="min-h-svh flex flex-col">
		<AccountView {...flags.props} path={view} redirectTo="/account" client:load />
	</body>
</html>
