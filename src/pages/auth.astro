---
/**
 * Plugin-shipped Better Auth UI (HeroUI) catch-all auth page.
 *
 * Injected at `/auth/[...path]` via the plugin's AuthProviderDescriptor.routes.
 * Serves every Better Auth UI view (sign-in, sign-up, forgot-password,
 * reset-password, sign-out, ...). The header, layout, and theme switcher all
 * live inside the AuthView island (they need Better Auth UI's provider
 * context); this page is just the document shell.
 *
 * Self-styled: HeroUI's stylesheet loads only with this island, so the site's
 * themed content pages are untouched.
 */
import { viewPaths } from "@better-auth-ui/core";
import { getSiteSettings } from "emdash";
import {
	configuredSocialProviders,
	twoFactorEnabled,
	orgEnabled,
	passkeyEnabled,
	oidcProviderEnabled,
	magicLinkEnabled,
	emailOtpEnabled,
	anonymousEnabled,
	multiSessionEnabled,
	genericOAuthProviderIds,
	accentColor,
	siteLogoUrl,
} from "../providers.ts";
import AuthView from "../ui/AuthView.tsx";

const { path } = Astro.params;
const view = path ?? "sign-in";

// Whether 2FA is enabled site-wide — gates both the two-factor plugin on the
// island and the challenge view path below (same setting the auth route reads).
const is2faEnabled = await twoFactorEnabled();
// Whether organizations are enabled — gates the org UI plugin on the island
// and the invitation-acceptance view path below.
const isOrgEnabled = await orgEnabled();
// Whether passkeys are enabled — gates the "Sign in with a passkey" button on
// the island (same setting the auth route reads).
const isPasskeyEnabled = await passkeyEnabled();
// Whether the OIDC provider is enabled — gates the oauth-provider UI plugin on
// the island and the oauth redirect-view paths (consent / sign-up) below.
const isOidcEnabled = await oidcProviderEnabled();
// Passwordless + session feature flags — gate the matching UI plugins / button
// on the island, each matching its backend plugin.
const isMagicLinkEnabled = await magicLinkEnabled();
const isEmailOtpEnabled = await emailOtpEnabled();
const isAnonymousEnabled = await anonymousEnabled();
const isMultiSessionEnabled = await multiSessionEnabled();

// The base `viewPaths.auth` from @better-auth-ui/core does NOT include plugin
// view segments (they're augmented at the TYPE level only, not the runtime
// object). So when a plugin is on we must explicitly allow its extra auth path
// through this guard, or the view would 404 before the island renders:
//   - 2FA on  → "two-factor" (the TOTP challenge view).
//   - org on  → "accept-invitation" (invite links: /auth/accept-invitation).
const knownViews = Object.values(viewPaths.auth) as string[];
//   - oidc on → "oauth-consent" + "oauth-sign-up" (the OAuth authorization
//     flow's consent and prompt=create sign-up redirect screens). With
//     multi-session also on, "select-account" (the account chooser).
//   - magic-link on → "magic-link" (the email-link request view).
//   - email-otp on  → "email-otp" (the code request/verify view).
const oauthViews = [
	"oauth-consent",
	"oauth-sign-up",
	...(isMultiSessionEnabled ? ["select-account"] : []),
];
const allowedViews = [
	...knownViews,
	...(is2faEnabled ? ["two-factor"] : []),
	...(isOrgEnabled ? ["accept-invitation"] : []),
	...(isOidcEnabled ? oauthViews : []),
	...(isMagicLinkEnabled ? ["magic-link"] : []),
	...(isEmailOtpEnabled ? ["email-otp"] : []),
];
if (!allowedViews.includes(view)) {
	return new Response("Not found", { status: 404 });
}

// A logged-in user is bounced off auth views (they're already signed in),
// EXCEPT sign-out, accept-invitation, and the OAuth consent/sign-up screens —
// those are reached mid-authorization-flow BY a signed-in user and must render,
// not redirect home. (oauth-sign-up falls back to plain sign-up when not in a
// prompt=create flow; a signed-in user won't normally land there.)
const signedInAllowed = new Set([
	"sign-out",
	"accept-invitation",
	...oauthViews,
]);
// select-account is in oauthViews only when multi-session is on; it's reached
// mid-authorization-flow by a signed-in user, so it must not redirect home.
if (Astro.locals.user && !signedInAllowed.has(view)) {
	return Astro.redirect("/");
}

const redirectTo = Astro.url.searchParams.get("redirect") || "/";
// Brand shown in the auth header — read from EmDash site settings so the
// plugin is site-agnostic (no hardcoded site name). Falls back generically.
const siteSettings = await getSiteSettings().catch(() => null);
const siteName = siteSettings?.title || "Account";
// Show a social button only for providers whose credentials are actually set
// (admin settings or env). Matches exactly what the auth route enables.
// Generic OAuth providers (env-configured) are first-class social providers in
// Better Auth, so they ride the same socialProviders list and render a button.
const builtinSocial = await configuredSocialProviders();
const genericSocial = await genericOAuthProviderIds();
const socialProviders = [...builtinSocial, ...genericSocial];
// Brand theming: accent color (operator setting) + optional site logo.
const accent = await accentColor();
const logoUrl = await siteLogoUrl();
---

<!doctype html>
<html lang="en" class="antialiased" style={`--emdash-accent: ${accent}`}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Account</title>
		<!-- Apply the saved theme before paint to avoid a light/dark flash.
		     Mirrors next-themes' storage key/behavior so the island hydrates
		     into the same state. -->
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem("theme") || "system";
					const dark =
						stored === "dark" ||
						(stored === "system" &&
							window.matchMedia("(prefers-color-scheme: dark)").matches);
					document.documentElement.classList.toggle("dark", dark);
				} catch {}
			})();
		</script>
	</head>
	<body class="min-h-svh flex flex-col">
		<AuthView
			path={view}
			redirectTo={redirectTo}
			siteName={siteName}
			logoUrl={logoUrl}
			socialProviders={socialProviders}
			twoFactorEnabled={is2faEnabled}
			orgEnabled={isOrgEnabled}
			passkeyEnabled={isPasskeyEnabled}
			oidcProviderEnabled={isOidcEnabled}
			magicLinkEnabled={isMagicLinkEnabled}
			emailOtpEnabled={isEmailOtpEnabled}
			anonymousEnabled={isAnonymousEnabled}
			multiSessionEnabled={isMultiSessionEnabled}
			client:load
		/>
	</body>
</html>
